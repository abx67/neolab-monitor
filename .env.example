# GitHub storage (optional — for persistent job history)
GITHUB_TOKEN=your_github_token_here
GITHUB_GIST_ID=optional_gist_id

# Email notifications (optional)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=recipient@gmail.com

# SMTP settings (optional — defaults work for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# LLM classification (optional — requires AGNES_API_KEY)
# Get key from: https://www.agnes-ai.com/en/docs/agnes-25-flash
AGNES_API_KEY=your_agnes_api_key_here

# Description cache TTL in hours (default: 24)
DESC_CACHE_TTL_HOURS=24
